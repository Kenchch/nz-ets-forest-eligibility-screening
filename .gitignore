.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.coverage
data/raw/*
!data/raw/.gitkeep
outputs/tmp/
outputs/ets-screen-*/
# Run logs (ets_screening.log, appended by every command) and trace runs.
outputs/**/*.log
outputs/trace/
*.egg-info/
.idea/
.vscode/

# ArcGIS auto-generates empty metadata stubs beside a .pyt on first import.
*.pyt.xml

# ArcGIS Pro project artefacts. Projects belong outside the repository;
# arcgis/build_layout.py writes its .aprx to the temp directory.
arcgis/MyProject/
*.aprx
*.atbx
*.gdb/
.backups/
ImportLog/
