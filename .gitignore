.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.coverage
data/raw/*
!data/raw/.gitkeep
outputs/tmp/
outputs/ets-screen-*/
# Machine-specific library versions and git state; varies by design.
outputs/**/run_environment.json
*.egg-info/
build/
.idea/
.vscode/

# ArcGIS auto-generates empty metadata stubs beside a .pyt on first import.
*.pyt.xml

# ArcGIS Pro project artefacts. Projects belong outside the repository;
# arcgis/build_layout.py writes its .aprx to the temp directory.
arcgis/MyProject/
*.aprx
*.atbx
*.gdb/
.backups/
ImportLog/
